// RISC-V LED Blinker Program
// 加载到 TCM，BOOT_VECTOR = 0x2000 → 字地址 0x800
//
// 程序逻辑：
//   x1 = 0x10000000 (GPIO_OUT 地址)
//   x2 = 计数器（每次+1，低8位驱动LED）
//   x3 = 延时循环变量
//
//   loop:
//     GPIO_OUT = x2        → LED 显示二进制计数
//     延时 ~4M 次循环
//     x2++
//     goto loop
//
// 若时钟=50MHz，延时≈0.25秒，LED以~2Hz变化

@00000800
100000B7
00000113
0020A023
004001B7
FFF18193
FE019EE3
00110113
FD9FF06F
